# Acrevia local environment
# Copy to .env.local (never commit real secrets).

# Server HMAC secret for the resolution envelope / commit receipt / mission
# attestation pair. Required in production; a dev fallback is used otherwise.
ACREVIA_RESOLUTION_SECRET=

# Copilot provider selection
# auto = prefer Gloo when configured, otherwise Anthropic fallback
ACREVIA_AI_PROVIDER=auto

# Gloo AI Studio — intended hackathon provider
ACREVIA_AI_BASE_URL=
ACREVIA_AI_API_KEY=
ACREVIA_AI_MODEL=

# Anthropic — fallback when Gloo is unavailable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional keyed GIS enrichment (Philadelphia provider stack).
AIS_GATEKEEPER_KEY=
