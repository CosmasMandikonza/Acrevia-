# Acrevia local environment
# Copy to .env.local (never commit real secrets).

# Server HMAC secret for the resolution envelope / commit receipt / mission
# attestation pair. Required in production; a dev fallback is used otherwise.
ACREVIA_RESOLUTION_SECRET=

# Copilot AI provider (issue #10). Any OpenAI-compatible chat-completions
# endpoint works — Gloo AI Studio / Gloo inference is the intended provider.
# All three variables are required to ENABLE the Copilot; without them the
# Copilot rail shows an honest "AI unavailable" state and every deterministic
# surface (Site, Scenarios, Forge, Evidence) keeps working.
ACREVIA_AI_BASE_URL=
ACREVIA_AI_API_KEY=
ACREVIA_AI_MODEL=

# Optional keyed GIS enrichment (Philadelphia provider stack).
AIS_GATEKEEPER_KEY=
